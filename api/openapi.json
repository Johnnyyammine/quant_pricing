{
  "components": {
    "schemas": {
      "BumpSettingsIn": {
        "additionalProperties": false,
        "description": "Bump sizes for bump-and-revalue greeks.",
        "properties": {
          "rate_abs": {
            "default": 0.0001,
            "exclusiveMinimum": 0.0,
            "maximum": 0.01,
            "title": "Rate Abs",
            "type": "number"
          },
          "spot_rel": {
            "default": 0.001,
            "exclusiveMinimum": 0.0,
            "maximum": 0.1,
            "title": "Spot Rel",
            "type": "number"
          },
          "time_days": {
            "default": 1,
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Time Days",
            "type": "integer"
          },
          "vol_abs": {
            "default": 0.001,
            "exclusiveMinimum": 0.0,
            "maximum": 0.05,
            "title": "Vol Abs",
            "type": "number"
          }
        },
        "title": "BumpSettingsIn",
        "type": "object"
      },
      "DiagnosticsOut": {
        "additionalProperties": false,
        "description": "Diagnostics of a pricing run.",
        "properties": {
          "details": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Details",
            "type": "object"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "method_label": {
            "title": "Method Label",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "revaluations": {
            "title": "Revaluations",
            "type": "integer"
          },
          "runtime_ms": {
            "description": "Engine wall-clock time for price and greeks, ms",
            "title": "Runtime Ms",
            "type": "number"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsIn"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "method",
          "method_label",
          "model",
          "runtime_ms",
          "revaluations",
          "settings",
          "details",
          "warnings"
        ],
        "title": "DiagnosticsOut",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Engine error surfaced to the client.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EuropeanOptionIn": {
        "additionalProperties": false,
        "description": "European call or put.",
        "properties": {
          "currency": {
            "default": "EUR",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "expiry": {
            "format": "date",
            "title": "Expiry",
            "type": "string"
          },
          "option_type": {
            "$ref": "#/components/schemas/OptionType"
          },
          "quantity": {
            "default": 1.0,
            "description": "Units of underlying",
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "number"
          },
          "strike": {
            "description": "Strike, in price units",
            "exclusiveMinimum": 0.0,
            "title": "Strike",
            "type": "number"
          },
          "type": {
            "const": "european",
            "default": "european",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "option_type",
          "strike",
          "expiry"
        ],
        "title": "EuropeanOptionIn",
        "type": "object"
      },
      "Greek": {
        "description": "Supported sensitivities, with their pure-unit definition.\n\n``V`` is the unit price, ``S`` spot, ``\u03c3`` the implied vol (parallel surface shift), ``r``\nthe discount zero rate, ``q`` the dividend yield, ``t`` calendar time in years (``\u03c4 = T \u2212 t``).",
        "enum": [
          "delta",
          "gamma",
          "vega",
          "theta",
          "rho",
          "phi",
          "vanna",
          "volga",
          "charm"
        ],
        "title": "Greek",
        "type": "string"
      },
      "GreekOut": {
        "additionalProperties": false,
        "description": "One greek in desk units.",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/Greek"
          },
          "source": {
            "$ref": "#/components/schemas/GreekSource"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": [
          "key",
          "value",
          "unit",
          "source"
        ],
        "title": "GreekOut",
        "type": "object"
      },
      "GreekSource": {
        "description": "How a greek was computed.",
        "enum": [
          "analytic",
          "bump"
        ],
        "title": "GreekSource",
        "type": "string"
      },
      "GreeksOut": {
        "additionalProperties": false,
        "description": "Greeks in both display modes so the UI can toggle without refetching.",
        "properties": {
          "cash": {
            "items": {
              "$ref": "#/components/schemas/GreekOut"
            },
            "title": "Cash",
            "type": "array"
          },
          "pure": {
            "items": {
              "$ref": "#/components/schemas/GreekOut"
            },
            "title": "Pure",
            "type": "array"
          }
        },
        "required": [
          "pure",
          "cash"
        ],
        "title": "GreeksOut",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Liveness probe.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HeatmapRequest": {
        "additionalProperties": false,
        "description": "Full-revaluation value grid over spot and vol shocks.",
        "properties": {
          "horizon_days": {
            "default": 0,
            "minimum": 0.0,
            "title": "Horizon Days",
            "type": "integer"
          },
          "pricing": {
            "$ref": "#/components/schemas/PriceRequest"
          },
          "spot_range_pct": {
            "default": 20.0,
            "exclusiveMaximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Spot Range Pct",
            "type": "number"
          },
          "spot_steps": {
            "default": 21,
            "maximum": 101.0,
            "minimum": 3.0,
            "title": "Spot Steps",
            "type": "integer"
          },
          "vol_range_pts": {
            "default": 10.0,
            "exclusiveMinimum": 0.0,
            "maximum": 100.0,
            "title": "Vol Range Pts",
            "type": "number"
          },
          "vol_steps": {
            "default": 21,
            "maximum": 101.0,
            "minimum": 3.0,
            "title": "Vol Steps",
            "type": "integer"
          }
        },
        "required": [
          "pricing"
        ],
        "title": "HeatmapRequest",
        "type": "object"
      },
      "HeatmapResponse": {
        "additionalProperties": false,
        "description": "Position values on a vol \u00d7 spot grid (rows: vol shifts). ``null`` = shock out of domain.",
        "properties": {
          "base_value": {
            "description": "Current position value, currency",
            "title": "Base Value",
            "type": "number"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "horizon_days": {
            "title": "Horizon Days",
            "type": "integer"
          },
          "notional": {
            "description": "quantity \u00d7 current spot, currency",
            "title": "Notional",
            "type": "number"
          },
          "spot_shifts_pct": {
            "items": {
              "type": "number"
            },
            "title": "Spot Shifts Pct",
            "type": "array"
          },
          "values": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "title": "Values",
            "type": "array"
          },
          "vol_shifts_pts": {
            "items": {
              "type": "number"
            },
            "title": "Vol Shifts Pts",
            "type": "array"
          }
        },
        "required": [
          "currency",
          "spot_shifts_pct",
          "vol_shifts_pts",
          "horizon_days",
          "base_value",
          "notional",
          "values"
        ],
        "title": "HeatmapResponse",
        "type": "object"
      },
      "ImpliedVolRequest": {
        "additionalProperties": false,
        "description": "Implied vol from a unit price. ``market.vol`` is ignored.",
        "properties": {
          "instrument": {
            "$ref": "#/components/schemas/EuropeanOptionIn"
          },
          "market": {
            "$ref": "#/components/schemas/MarketIn"
          },
          "model": {
            "$ref": "#/components/schemas/ModelIn",
            "default": {
              "type": "bsm"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsIn",
            "default": {
              "bumps": {
                "rate_abs": 0.0001,
                "spot_rel": 0.001,
                "time_days": 1,
                "vol_abs": 0.001
              },
              "force_bump_greeks": false,
              "implied_vol": {
                "max_iterations": 2
              }
            }
          },
          "target_price": {
            "description": "Unit price, currency",
            "exclusiveMinimum": 0.0,
            "title": "Target Price",
            "type": "number"
          }
        },
        "required": [
          "instrument",
          "market",
          "target_price"
        ],
        "title": "ImpliedVolRequest",
        "type": "object"
      },
      "ImpliedVolResponse": {
        "additionalProperties": false,
        "description": "Implied vol and the quantities it was solved from.",
        "properties": {
          "discount_factor": {
            "title": "Discount Factor",
            "type": "number"
          },
          "forward": {
            "title": "Forward",
            "type": "number"
          },
          "implied_vol": {
            "description": "Decimal",
            "title": "Implied Vol",
            "type": "number"
          },
          "time_to_expiry": {
            "title": "Time To Expiry",
            "type": "number"
          }
        },
        "required": [
          "implied_vol",
          "forward",
          "discount_factor",
          "time_to_expiry"
        ],
        "title": "ImpliedVolResponse",
        "type": "object"
      },
      "ImpliedVolSettingsIn": {
        "additionalProperties": false,
        "description": "Implied-vol solver settings.",
        "properties": {
          "max_iterations": {
            "default": 2,
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Iterations",
            "type": "integer"
          }
        },
        "title": "ImpliedVolSettingsIn",
        "type": "object"
      },
      "MarketIn": {
        "additionalProperties": false,
        "description": "Flat market: continuously compounded rates, ACT/365F.\n\nUnder Black-76, ``spot`` is the forward (futures) price for the option expiry and the\ndividend yield and borrow spread are ignored.",
        "properties": {
          "borrow": {
            "default": 0.0,
            "description": "Repo/borrow spread, continuous, decimal",
            "title": "Borrow",
            "type": "number"
          },
          "dividend_yield": {
            "default": 0.0,
            "description": "Continuous dividend yield, decimal",
            "title": "Dividend Yield",
            "type": "number"
          },
          "rate": {
            "description": "Discount zero rate, continuous, decimal",
            "title": "Rate",
            "type": "number"
          },
          "spot": {
            "exclusiveMinimum": 0.0,
            "title": "Spot",
            "type": "number"
          },
          "valuation_date": {
            "format": "date",
            "title": "Valuation Date",
            "type": "string"
          },
          "vol": {
            "description": "Implied volatility, decimal",
            "exclusiveMinimum": 0.0,
            "maximum": 5.0,
            "title": "Vol",
            "type": "number"
          }
        },
        "required": [
          "valuation_date",
          "spot",
          "rate",
          "vol"
        ],
        "title": "MarketIn",
        "type": "object"
      },
      "MetaResponse": {
        "additionalProperties": false,
        "description": "Static metadata for the UI.",
        "properties": {
          "methods": {
            "items": {
              "$ref": "#/components/schemas/MethodOut"
            },
            "title": "Methods",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "methods"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "MethodOut": {
        "additionalProperties": false,
        "description": "A registered pricing method.",
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "label"
        ],
        "title": "MethodOut",
        "type": "object"
      },
      "ModelIn": {
        "additionalProperties": false,
        "description": "Model selection.",
        "properties": {
          "type": {
            "default": "bsm",
            "enum": [
              "bsm",
              "black76"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "title": "ModelIn",
        "type": "object"
      },
      "OptionType": {
        "description": "Call or put. ``omega`` is +1 for a call and \u22121 for a put.",
        "enum": [
          "call",
          "put"
        ],
        "title": "OptionType",
        "type": "string"
      },
      "PriceRequest": {
        "additionalProperties": false,
        "description": "Price one instrument.",
        "properties": {
          "instrument": {
            "$ref": "#/components/schemas/EuropeanOptionIn"
          },
          "market": {
            "$ref": "#/components/schemas/MarketIn"
          },
          "method": {
            "default": "analytic",
            "title": "Method",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/ModelIn",
            "default": {
              "type": "bsm"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsIn",
            "default": {
              "bumps": {
                "rate_abs": 0.0001,
                "spot_rel": 0.001,
                "time_days": 1,
                "vol_abs": 0.001
              },
              "force_bump_greeks": false,
              "implied_vol": {
                "max_iterations": 2
              }
            }
          }
        },
        "required": [
          "instrument",
          "market"
        ],
        "title": "PriceRequest",
        "type": "object"
      },
      "PriceResponse": {
        "additionalProperties": false,
        "description": "Price, market-derived quantities, greeks and diagnostics.",
        "properties": {
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/DiagnosticsOut"
          },
          "discount_factor": {
            "title": "Discount Factor",
            "type": "number"
          },
          "forward": {
            "title": "Forward",
            "type": "number"
          },
          "greeks": {
            "$ref": "#/components/schemas/GreeksOut"
          },
          "notional": {
            "description": "quantity \u00d7 spot, currency",
            "title": "Notional",
            "type": "number"
          },
          "pct_notional": {
            "description": "100 \u00d7 unit price / spot, %",
            "title": "Pct Notional",
            "type": "number"
          },
          "position_value": {
            "description": "quantity \u00d7 unit price, currency",
            "title": "Position Value",
            "type": "number"
          },
          "price": {
            "description": "Unit price, currency",
            "title": "Price",
            "type": "number"
          },
          "time_to_expiry": {
            "description": "ACT/365F year fraction",
            "title": "Time To Expiry",
            "type": "number"
          }
        },
        "required": [
          "currency",
          "price",
          "position_value",
          "pct_notional",
          "notional",
          "forward",
          "discount_factor",
          "time_to_expiry",
          "greeks",
          "diagnostics"
        ],
        "title": "PriceResponse",
        "type": "object"
      },
      "ProfileRequest": {
        "additionalProperties": false,
        "description": "Price and greeks along spot (at several horizons) or along time (at several spot shifts).",
        "properties": {
          "axis": {
            "enum": [
              "spot",
              "time"
            ],
            "title": "Axis",
            "type": "string"
          },
          "horizons_days": {
            "default": [
              0
            ],
            "description": "Spot axis: valuation-date rolls",
            "items": {
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Horizons Days",
            "type": "array"
          },
          "points": {
            "default": 81,
            "maximum": 201.0,
            "minimum": 2.0,
            "title": "Points",
            "type": "integer"
          },
          "pricing": {
            "$ref": "#/components/schemas/PriceRequest"
          },
          "spot_range_pct": {
            "default": 30.0,
            "description": "Spot axis: \u00b1range, %",
            "exclusiveMaximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Spot Range Pct",
            "type": "number"
          },
          "spot_shifts_pct": {
            "default": [
              0.0
            ],
            "description": "Time axis: spot shifts, %",
            "items": {
              "type": "number"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Spot Shifts Pct",
            "type": "array"
          }
        },
        "required": [
          "pricing",
          "axis"
        ],
        "title": "ProfileRequest",
        "type": "object"
      },
      "ProfileResponse": {
        "additionalProperties": false,
        "description": "Profiles along spot or time.",
        "properties": {
          "axis": {
            "enum": [
              "spot",
              "time"
            ],
            "title": "Axis",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "notional": {
            "description": "quantity \u00d7 current spot, currency",
            "title": "Notional",
            "type": "number"
          },
          "payoff": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Spot axis: position payoff at expiry",
            "title": "Payoff"
          },
          "series": {
            "items": {
              "$ref": "#/components/schemas/ProfileSeries"
            },
            "title": "Series",
            "type": "array"
          },
          "spot": {
            "title": "Spot",
            "type": "number"
          },
          "strike": {
            "title": "Strike",
            "type": "number"
          },
          "units": {
            "additionalProperties": {
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "$ref": "#/components/schemas/Greek"
              },
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "pure",
                "cash"
              ]
            },
            "title": "Units",
            "type": "object"
          },
          "x": {
            "description": "Spot level, or days to expiry",
            "items": {
              "type": "number"
            },
            "title": "X",
            "type": "array"
          }
        },
        "required": [
          "axis",
          "x",
          "currency",
          "notional",
          "strike",
          "spot",
          "payoff",
          "units",
          "series"
        ],
        "title": "ProfileResponse",
        "type": "object"
      },
      "ProfileSeries": {
        "additionalProperties": false,
        "description": "One line family of a profile: value and greeks along the x axis.",
        "properties": {
          "greeks": {
            "additionalProperties": {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "propertyNames": {
                "$ref": "#/components/schemas/Greek"
              },
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "pure",
                "cash"
              ]
            },
            "title": "Greeks",
            "type": "object"
          },
          "horizon_days": {
            "title": "Horizon Days",
            "type": "integer"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "position_value": {
            "items": {
              "type": "number"
            },
            "title": "Position Value",
            "type": "array"
          },
          "spot_shift_pct": {
            "title": "Spot Shift Pct",
            "type": "number"
          }
        },
        "required": [
          "label",
          "horizon_days",
          "spot_shift_pct",
          "position_value",
          "greeks"
        ],
        "title": "ProfileSeries",
        "type": "object"
      },
      "SettingsIn": {
        "additionalProperties": false,
        "description": "Numerical settings.",
        "properties": {
          "bumps": {
            "$ref": "#/components/schemas/BumpSettingsIn",
            "default": {
              "rate_abs": 0.0001,
              "spot_rel": 0.001,
              "time_days": 1,
              "vol_abs": 0.001
            }
          },
          "force_bump_greeks": {
            "default": false,
            "description": "Bump-and-revalue every greek, even where closed forms exist",
            "title": "Force Bump Greeks",
            "type": "boolean"
          },
          "implied_vol": {
            "$ref": "#/components/schemas/ImpliedVolSettingsIn",
            "default": {
              "max_iterations": 2
            }
          }
        },
        "title": "SettingsIn",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Quant Pricer API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness probe.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/heatmap": {
      "post": {
        "description": "Full-revaluation position values over spot \u00d7 vol shocks, optionally after a time roll.",
        "operationId": "heatmap_api_heatmap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HeatmapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
